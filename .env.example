# SEC asks every client to identify itself: your name and a contact email.
SEC_USER_AGENT="Your Name you@example.com"
# LangSmith (smith.langchain.com -> Settings -> API Keys)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=filings-agent
# An AWS profile with bedrock:InvokeModel in us-east-1
AWS_PROFILE=
# Optional: a spend ledger shared with other projects on the same AWS account
# SPEND_SHARED_LEDGER=/path/to/spend_ledger.json
